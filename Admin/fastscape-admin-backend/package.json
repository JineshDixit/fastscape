{
  "name": "rental-car-admin-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --exec ts-node src/server.ts",
    "start": "cross-env NODE_ENV=development node dist/src/server.js",
    "watch": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"yellow.bold,cyan.bold\" \"npm run watch-ts\" \"npm run watch-node\"",
    "watch-ts": "tsc --watch",
    "watch-node": "cross-env NODE_ENV=development nodemon --delay 1000ms dist/src/server.js",
    "build": "tsc",
    "pretty": "npx prettier --write .",
    "sync:db": "cross-env NODE_ENV=development ts-node src/scripts/syncDatabase.ts",
    "seed:superadmin": "cross-env NODE_ENV=development ts-node src/seeders/adminSeeder.ts",
    "seed:vehicles": "cross-env NODE_ENV=development ts-node src/seeders/vehicleSeeder.ts",
    "seed:chauffeurs": "cross-env NODE_ENV=development ts-node src/seeders/chauffeurSeeder.ts",
    "seed:locations": "cross-env NODE_ENV=development ts-node src/seeders/locationSeeder.ts",
    "seed:all": "cross-env NODE_ENV=development ts-node src/seeders/allSeeder.ts",
    "seed": "cross-env NODE_ENV=development ts-node src/seeders/allSeeder.ts"
  },
  "author": "Nishchay",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "sequelize": "^6.37.7",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.11.10",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
