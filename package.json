  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --exec ts-node src/server.ts",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "watch": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"yellow.bold,cyan.bold\" \"npm run watch-ts\" \"npm run watch-node\"",
    "watch-ts": "tsc --watch",
    "watch-node": "cross-env NODE_ENV=development nodemon --delay 1000ms dist/src/server.js",
    "build": "tsc",
    "pretty": "npx prettier --write ."
  },
